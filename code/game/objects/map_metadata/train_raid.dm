///////////////////////////////Map metadata//////////////////////////////////////////////

/mob/living/human
	var/tmp/train_raid_crew

/obj/map_metadata/train_raid
	ID = MAP_TRAIN_RAID
	title = "Train Raid"
	description = "Two crews dock their shuttles beside the Hauler freight train, board it, loot its sections rear to front and get the loot back aboard before the line collapses."
	lobby_icon = "icons/lobby/battleroyale.png"
	faction_organization = list(CIVILIAN)
	faction1 = CIVILIAN
	faction2 = CIVILIAN
	is_singlefaction = TRUE
	ordinal_age = 8
	age = "2019"
	respawn_delay = 300
	gamemode = "Train Raid"
	battle_name = "Train Raid"
	valid_weather_types = list(WEATHER_NONE)
	no_time_of_day_cycle = TRUE
	// Balance settings. Times are in deciseconds like the rest of the map code.
	var/round_duration = 60 MINUTES
	var/boarding_window = 5 MINUTES
	var/recall_travel = 3 MINUTES
	var/docking_window = 2 MINUTES
	var/recall_cooldown = 5 MINUTES
	var/lives_per_raider = 3
	var/tmp/round_started = 0
	var/tmp/round_deadline = 0
	var/tmp/game_over = FALSE
	var/tmp/list/warnings_sent = list()
	var/tmp/list/crews = list()

/obj/map_metadata/train_raid/New()
	..()
	for (var/id in list("west", "east"))
		crews[id] = new /datum/train_raid_crew(id, src)

/obj/map_metadata/train_raid/proc/crew(id)
	return istext(id) ? crews[id] : null

/obj/map_metadata/train_raid/proc/crew_of(mob/living/human/H)
	return istype(H) ? crew(H.train_raid_crew) : null

/obj/map_metadata/train_raid/proc/raider_key(mob/living/human/H)
	if (!istype(H)) return null
	if (H.client) return H.client.ckey
	if (H.ckey) return H.ckey
	if (H.mind && H.mind.key) return ckey(H.mind.key)
	return null

/obj/map_metadata/train_raid/proc/remaining_text()
	var/remaining = max(0, round_deadline - world.time)
	var/minutes = round(remaining / (1 MINUTE))
	var/seconds = round((remaining - minutes * (1 MINUTE)) / (1 SECOND))
	return "[minutes]:[seconds < 10 ? "0" : ""][seconds]"

/obj/map_metadata/train_raid/update_win_condition()
	return game_over

/obj/map_metadata/train_raid/tick()
	if (game_over || !ticker || ticker.current_state != GAME_STATE_PLAYING) return
	if (!round_started)
		start_round()
	for (var/id in crews)
		var/datum/train_raid_crew/C = crews[id]
		C.tick()
	var/remaining = round_deadline - world.time
	for (var/mark in list(30, 15, 5, 1))
		if (remaining <= mark MINUTES && !warnings_sent["[mark]"])
			warnings_sent["[mark]"] = TRUE
			to_chat(world, SPAN_DANGER("<font size=3>The line collapses in [mark] minute[mark == 1 ? "" : "s"]. Anything still on the Hauler will be lost.</font>"))
			break
		else if (remaining <= mark MINUTES)
			break
	if (remaining <= 0)
		collapse()

/obj/map_metadata/train_raid/proc/start_round()
	round_started = world.time
	round_deadline = world.time + round_duration
	for (var/id in crews)
		var/datum/train_raid_crew/C = crews[id]
		C.dock(world.time + boarding_window, TRUE)
	to_chat(world, "<font size=4>Both shuttles are docked beside the Hauler. They depart in [boarding_window / (1 MINUTE)] minutes; use the helm to leave earlier. The line collapses in [round_duration / (1 MINUTE)] minutes.</font>")

// Every raider has lives; a death with lives left and a claimed bed returns
// them beside that bed, otherwise in their shuttle's bunks.
/obj/map_metadata/train_raid/proc/raider_died(mob/living/human/H)
	var/datum/train_raid_crew/C = crew_of(H)
	var/key = raider_key(H)
	if (!C || !key) return
	C.lives[key] = max(0, C.lives_of(key) - 1)
	var/left = C.lives[key]
	if (left > 0 && C.bed_turf(key))
		to_chat(H, SPAN_WARNING("You have [left] [left == 1 ? "life" : "lives"] left. You will return beside your claimed bed with a fresh kit."))
	else if (left > 0)
		to_chat(H, SPAN_WARNING("You have [left] [left == 1 ? "life" : "lives"] left but no claimed bed. You will return aboard the [C.title] shuttle."))
	else
		to_chat(H, SPAN_WARNING("You are out of lives. You will return aboard the [C.title] shuttle with nothing you were carrying."))

// Called from the job's equip: binds the body to its crew and points the
// spawn at the claimed bed when the raider still has lives.
/obj/map_metadata/train_raid/proc/register(mob/living/human/H, crew_id)
	var/datum/train_raid_crew/C = crew(crew_id)
	if (!C) return FALSE
	H.train_raid_crew = crew_id
	var/key = raider_key(H)
	if (!key) return FALSE
	if (isnull(C.lives[key])) C.lives[key] = lives_per_raider
	var/turf/T = C.lives_of(key) > 0 ? C.bed_turf(key) : null
	if (T)
		var/location = "TrainRaidBed_[crew_id]_[key]"
		latejoin_turfs[location] = list(T)
		H.job_spawn_location = location
	to_chat(H, "You are a raider of the [C.title] shuttle. Lives left: [C.lives_of(key)]. [C.status_text()]")
	return TRUE

/obj/map_metadata/train_raid/proc/on_hauler(atom/A)
	var/area/AR = get_area(A)
	return istype(AR, /area/train_raid/hauler) || istype(AR, /area/train_raid/station)

/obj/map_metadata/train_raid/proc/value_of(atom/A, depth = 0)
	var/total = 0
	if (istype(A, /obj/item))
		var/obj/item/I = A
		total += max(0, I.value)
	if (depth >= 6) return total
	for (var/atom/movable/AM in A.contents)
		if (istype(AM, /obj/item) || istype(AM, /obj/structure/closet) || ismob(AM))
			total += value_of(AM, depth + 1)
	return total

/obj/map_metadata/train_raid/proc/collapse()
	if (game_over) return
	game_over = TRUE
	to_chat(world, SPAN_DANGER("<font size=4>The line collapses. The Hauler and everything still aboard it are lost.</font>"))
	var/list/lost = list()
	for (var/area/A in world)
		if (!istype(A, /area/train_raid/hauler) && !istype(A, /area/train_raid/station)) continue
		for (var/turf/T in A)
			for (var/mob/living/human/H in T)
				if (H.stat != DEAD) lost += H
			for (var/obj/item/I in T)
				qdel(I)
	for (var/mob/living/human/H in lost)
		to_chat(H, SPAN_DANGER("You were still on the Hauler when the line collapsed."))
		H.death()
	var/list/lines = list()
	for (var/id in crews)
		var/datum/train_raid_crew/C = crews[id]
		var/value = C.secured_value()
		var/aboard = C.members_aboard().len
		lines += "[C.title] shuttle: [value] secured value, [aboard] raider[aboard == 1 ? "" : "s"] aboard, [lost.len ? "" : "nobody "]lost on the Hauler."
	to_chat(world, "<big><b>Round over.</b></big>")
	for (var/line in lines)
		to_chat(world, "<big>[line]</big>")
	if (ticker) ticker.finished = TRUE

///////////////////////////////Crews//////////////////////////////////////////////

/datum/train_raid_crew
	var/id
	var/title
	var/obj/map_metadata/train_raid/mode
	var/state = TRAIN_RAID_AWAY
	var/state_until = 0
	var/next_recall = 0
	var/list/lives = list()
	var/list/beds = list()

/datum/train_raid_crew/New(crew_id, obj/map_metadata/train_raid/M)
	..()
	id = crew_id
	title = capitalize(crew_id)
	mode = M

/datum/train_raid_crew/proc/lives_of(key)
	return isnull(lives[key]) ? mode.lives_per_raider : lives[key]

/datum/train_raid_crew/proc/members()
	var/list/result = list()
	for (var/mob/living/human/H in player_list)
		if (H.train_raid_crew == id && H.stat != DEAD && H.loc) result += H
	return result

/datum/train_raid_crew/proc/aboard(atom/A)
	var/area/AR = get_area(A)
	return istype(AR, text2path("/area/train_raid/shuttle/[id]"))

/datum/train_raid_crew/proc/members_aboard()
	var/list/result = list()
	for (var/mob/living/human/H in members())
		if (aboard(H)) result += H
	return result

/datum/train_raid_crew/proc/store_turfs()
	var/list/turfs = latejoin_turfs["TrainStores[title]"]
	return islist(turfs) ? turfs : list()

/datum/train_raid_crew/proc/status_text()
	switch (state)
		if (TRAIN_RAID_DOCKED) return "The shuttle is docked; it departs in [max(0, round((state_until - world.time) / (1 MINUTE)))] minute(s)."
		if (TRAIN_RAID_INBOUND) return "The shuttle arrives in [max(0, round((state_until - world.time) / (1 MINUTE)))] minute(s)."
	if (world.time < next_recall) return "The shuttle is away and can be recalled in [max(0, round((next_recall - world.time) / (1 MINUTE)))] minute(s)."
	return "The shuttle is away. Use a shuttle beacon on the Hauler to recall it."

/datum/train_raid_crew/proc/announce(message)
	for (var/mob/living/human/H in members())
		to_chat(H, SPAN_NOTICE("<b>[title] shuttle:</b> [message]"))

/datum/train_raid_crew/proc/tick()
	switch (state)
		if (TRAIN_RAID_INBOUND)
			if (world.time >= state_until) dock(world.time + mode.docking_window)
		if (TRAIN_RAID_DOCKED)
			if (state_until && world.time >= state_until) depart()

/datum/train_raid_crew/proc/set_bridges(extended)
	for (var/obj/structure/train_raid_bridge/B in train_raid_bridges)
		if (B.crew == id) B.set_extended(extended)

/datum/train_raid_crew/proc/dock(until, initial = FALSE)
	state = TRAIN_RAID_DOCKED
	state_until = until
	set_bridges(TRUE)
	if (!initial) announce("The shuttle has docked. Its bridges are out for [round((until - world.time) / (1 MINUTE))] minute(s); be aboard when they retract.")

/datum/train_raid_crew/proc/depart()
	state = TRAIN_RAID_AWAY
	state_until = 0
	next_recall = world.time + mode.recall_cooldown
	set_bridges(FALSE)
	var/list/aboard = members_aboard()
	announce("The shuttle has departed with [aboard.len] raider[aboard.len == 1 ? "" : "s"] aboard. Loot on the shuttle is secured.")
	for (var/mob/living/human/H in members())
		if (!(H in aboard) && mode.on_hauler(H)) to_chat(H, SPAN_WARNING("You stayed on the Hauler. Use your shuttle beacon to call the shuttle back once it is clear."))

/datum/train_raid_crew/proc/recall(mob/living/human/H)
	if (mode.game_over) return FALSE
	if (state == TRAIN_RAID_DOCKED)
		to_chat(H, "The shuttle is already docked.")
		return FALSE
	if (state == TRAIN_RAID_INBOUND)
		to_chat(H, "The shuttle is already on its way.")
		return FALSE
	if (world.time < next_recall)
		to_chat(H, "The shuttle cannot return yet. [status_text()]")
		return FALSE
	if (!mode.on_hauler(H))
		to_chat(H, "The beacon only reaches the shuttle from the Hauler or the station.")
		return FALSE
	state = TRAIN_RAID_INBOUND
	state_until = world.time + mode.recall_travel
	announce("[H.real_name] has recalled the shuttle. It arrives in [round(mode.recall_travel / (1 MINUTE))] minute(s) and stays for [round(mode.docking_window / (1 MINUTE))].")
	return TRUE

/datum/train_raid_crew/proc/depart_now(mob/living/human/H)
	if (mode.game_over || state != TRAIN_RAID_DOCKED)
		to_chat(H, status_text())
		return FALSE
	announce("[H.real_name] ordered the shuttle to depart.")
	depart()
	return TRUE

/datum/train_raid_crew/proc/claim_bed(mob/living/human/H, obj/structure/bed/train_raid/B)
	var/key = mode.raider_key(H)
	if (!key) return FALSE
	for (var/other in beds)
		if (beds[other] == B && other != key)
			to_chat(H, "This bed is already claimed by another raider.")
			return FALSE
	for (var/other_id in mode.crews)
		var/datum/train_raid_crew/other_crew = mode.crews[other_id]
		if (other_crew == src) continue
		for (var/other in other_crew.beds)
			if (other_crew.beds[other] == B)
				to_chat(H, "This bed is already claimed by another raider.")
				return FALSE
	if (beds[key] == B)
		to_chat(H, "This is already your respawn bed.")
		return TRUE
	beds[key] = B
	to_chat(H, SPAN_NOTICE("You claim this bed. While you have lives left you will return beside it."))
	return TRUE

/datum/train_raid_crew/proc/release_bed(obj/structure/bed/train_raid/B)
	for (var/key in beds.Copy())
		if (beds[key] == B) beds -= key

/datum/train_raid_crew/proc/bed_turf(key)
	var/obj/structure/bed/train_raid/B = beds[key]
	if (!B || QDELETED(B) || !isturf(B.loc))
		beds -= key
		return null
	var/turf/origin = get_turf(B)
	for (var/dx in -1 to 1)
		for (var/dy in -1 to 1)
			if (!dx && !dy) continue
			var/turf/T = locate(origin.x + dx, origin.y + dy, origin.z)
			if (!T || T.density) continue
			var/blocked = FALSE
			for (var/atom/movable/A in T)
				if (A.density && (istype(A, /obj/structure) || isliving(A)))
					blocked = TRUE
					break
			if (!blocked) return T
	return null

/datum/train_raid_crew/proc/secured_value()
	var/total = 0
	for (var/area/A in world)
		if (!aboard(A)) continue
		for (var/turf/T in A)
			for (var/atom/movable/AM in T)
				if (istype(AM, /obj/item) || istype(AM, /obj/structure/closet) || ishuman(AM))
					total += mode.value_of(AM)
	return total

