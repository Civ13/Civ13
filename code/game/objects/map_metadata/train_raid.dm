// Train Raid: two crews dock their shuttle trains beside the Hauler freight
// train, board it, loot its tiered sections and get the loot back aboard
// before the line collapses. The map is generated by tests/train_raid/build.py
// from the Dagger map studies; see docs/train-raid-mode.md.
// Selected by name (train_raid) like Factory; never part of a vote rotation.

#define TRAIN_RAID_DOCKED "docked"
#define TRAIN_RAID_AWAY "away"
#define TRAIN_RAID_INBOUND "inbound"

var/global/list/train_raid_bridges = list()
var/global/list/train_raid_helms = list()
var/global/list/train_raid_loot_pads = list()

