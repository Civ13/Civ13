/datum/job/civilian/train_raid
	title = "Raider"
	allowed_maps = list(MAP_TRAIN_RAID)
	min_positions = 1
	max_positions = 8
	is_outlaw = TRUE
	var/crew = "west"

/datum/job/civilian/train_raid/west
	title = "West shuttle raider"
	spawn_location = "JoinLateTrainWest"
	crew = "west"

/datum/job/civilian/train_raid/east
	title = "East shuttle raider"
	spawn_location = "JoinLateTrainEast"
	crew = "east"

/datum/job/civilian/train_raid/equip(mob/living/human/H)
	if (!H) return FALSE
	H.equip_to_slot_or_del(new /obj/item/clothing/shoes/jackboots(H), slot_shoes)
	H.equip_to_slot_or_del(new /obj/item/clothing/under/tactical1(H), slot_w_uniform)
	H.equip_to_slot_or_del(new /obj/item/weapon/storage/backpack/satchel(H), slot_back)
	H.equip_to_slot_or_del(new /obj/item/weapon/material/kitchen/utensil/knife(H), slot_belt)
	H.equip_to_slot_or_del(new /obj/item/train_raid_beacon(H), slot_l_store)
	H.equip_to_slot_or_del(new /obj/item/train_raid_balloon(H), slot_r_store)
	if (H.back) new /obj/item/train_raid_balloon(H.back)
	give_random_name(H)
	H.add_note("Role", "Raid the Hauler with your crew. Lift balloons send one item or crate to your shuttle's stores; your shuttle beacon recalls the shuttle from the Hauler. Click a bed to claim it as your respawn point. Everything left on the Hauler is lost when the line collapses.")
	H.setStat("strength", STAT_MEDIUM_HIGH)
	H.setStat("crafting", STAT_NORMAL)
	H.setStat("rifle", STAT_MEDIUM_HIGH)
	H.setStat("dexterity", STAT_MEDIUM_HIGH)
	H.setStat("swords", STAT_NORMAL)
	H.setStat("pistol", STAT_NORMAL)
	H.setStat("bows", STAT_NORMAL)
	H.setStat("medical", STAT_NORMAL)
	var/obj/map_metadata/train_raid/M = map
	if (istype(M)) M.register(H, crew)
	return TRUE

/hook/death/proc/train_raid_death(mob/living/human/H, gibbed)
	var/obj/map_metadata/train_raid/M = map
	if (istype(M) && istype(H)) M.raider_died(H)
	return TRUE

///////////////////////////////Structures//////////////////////////////////////////////

// A bridge tile between a shuttle boarding port and the platform. Retracted,
// it is an impassable gap; extended, it is an ordinary walkway.
/obj/structure/train_raid_bridge
	name = "retracted bridge"
	desc = "The boarding bridge is retracted. Nothing crosses here until the shuttle docks."
	icon = 'icons/obj/railing.dmi'
	icon_state = "railing0"
	anchored = TRUE
	density = TRUE
	opacity = FALSE
	not_movable = TRUE
	not_disassemblable = TRUE
	var/crew = "west"
	var/extended = FALSE

/obj/structure/train_raid_bridge/New()
	..()
	train_raid_bridges |= src

/obj/structure/train_raid_bridge/Destroy()
	train_raid_bridges -= src
	return ..()

/obj/structure/train_raid_bridge/proc/set_extended(out)
	extended = out
	if (extended)
		density = FALSE
		invisibility = 101
		name = "boarding bridge"
		for (var/mob/living/L in loc)
			L.visible_message(SPAN_NOTICE("The bridge extends."))
	else
		density = TRUE
		invisibility = 0
		name = "retracted bridge"
		// Nobody rides a retracting bridge: anyone on it steps onto the platform.
		var/dir_to_platform = crew == "west" ? EAST : WEST
		for (var/mob/living/L in loc)
			var/turf/T = get_turf(src)
			for (var/i in 1 to 8)
				T = get_step(T, dir_to_platform)
				if (!T) break
				if (!(locate(/obj/structure/train_raid_bridge) in T)) break
			if (T && !T.density)
				L.forceMove(T)
				to_chat(L, SPAN_WARNING("The bridge retracts under you and you jump back onto the platform."))

/obj/structure/train_raid_bridge/attack_hand(mob/user, icon_x, icon_y)
	to_chat(user, extended ? "The boarding bridge is out." : "The bridge is retracted; the shuttle is away.")

/obj/structure/train_raid_bridge/ex_act(severity)
	return

/obj/structure/train_raid_bridge/bullet_act(obj/item/projectile/P)
	return

// Shuttle helm: shows the shuttle state and lets the crew depart early.
/obj/structure/train_raid_helm
	name = "shuttle helm"
	desc = "The shuttle's controls. Crew can order an early departure from here."
	icon = 'icons/obj/computers.dmi'
	icon_state = "computer"
	anchored = TRUE
	density = TRUE
	not_movable = TRUE
	not_disassemblable = TRUE
	var/crew = "west"

/obj/structure/train_raid_helm/New()
	..()
	train_raid_helms |= src

/obj/structure/train_raid_helm/Destroy()
	train_raid_helms -= src
	return ..()

/obj/structure/train_raid_helm/attack_hand(mob/user, icon_x, icon_y)
	var/mob/living/human/H = user
	var/obj/map_metadata/train_raid/M = map
	if (!istype(H) || !istype(M) || !Adjacent(H) || H.stat != CONSCIOUS) return
	var/datum/train_raid_crew/C = M.crew(crew)
	if (!C) return
	if (H.train_raid_crew != crew)
		to_chat(H, "These controls answer only to the [C.title] crew.")
		return
	var/list/options = list("Cancel")
	if (C.state == TRAIN_RAID_DOCKED) options.Insert(1, "Depart now")
	var/choice = WWinput(H, "[C.status_text()] Lives left: [C.lives_of(M.raider_key(H))]. Line collapse in [M.remaining_text()].", "[C.title] shuttle helm", "Cancel", options)
	if (choice == "Depart now" && Adjacent(H) && H.stat == CONSCIOUS) C.depart_now(H)

/obj/structure/train_raid_helm/ex_act(severity)
	return

/obj/structure/train_raid_helm/bullet_act(obj/item/projectile/P)
	return

// Crew-only airlock door: opens for the owning crew and cannot be forced,
// damaged, picked or dismantled by anyone.
/obj/structure/simple_door/train_raid_crew
	name = "crew airlock door"
	desc = "A heavy shuttle door. It opens only for its own crew."
	var/crew = "west"

/obj/structure/simple_door/train_raid_crew/New(newloc, material_name)
	..(newloc, "steel")
	name = initial(name)

/obj/structure/simple_door/train_raid_crew/proc/crew_member(mob/user)
	var/mob/living/human/H = user
	return istype(H) && H.train_raid_crew == crew

/obj/structure/simple_door/train_raid_crew/door_hand_locked(mob/user)
	return !crew_member(user)

/obj/structure/simple_door/train_raid_crew/canOpen(mob/user)
	return crew_member(user)

/obj/structure/simple_door/train_raid_crew/door_kick(mob/user)
	return door_rattle(user)

/obj/structure/simple_door/train_raid_crew/attackby(obj/item/weapon/W, mob/user)
	if (!crew_member(user))
		door_rattle(user)
		return
	// Crew hands open or close it; tools and weapons never change it.
	return door_intent_interact(user)

