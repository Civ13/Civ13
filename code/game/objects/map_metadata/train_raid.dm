	return

/obj/structure/simple_door/train_raid_crew/ex_act(severity)
	return

/obj/structure/simple_door/train_raid_crew/fire_act(temperature)
	return

/obj/structure/simple_door/train_raid_crew/TemperatureAct(temperature)
