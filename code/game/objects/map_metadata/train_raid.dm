// Claimable respawn bed, on the Hauler coaches and in the shuttle bunks.
/obj/structure/bed/train_raid
	name = "bunk"
	desc = "A train bunk. Click it to claim it as your respawn point."
	material = "wood"

/obj/structure/bed/train_raid/attack_hand(mob/user, icon_x, icon_y)
	var/mob/living/human/H = user
	var/obj/map_metadata/train_raid/M = map
	if (!istype(H) || !istype(M) || !Adjacent(H) || H.stat != CONSCIOUS) return ..()
	var/datum/train_raid_crew/C = M.crew_of(H)
	if (!C) return ..()
	C.claim_bed(H, src)

/obj/structure/bed/train_raid/examine(mob/user, distance = -1)
	..()
	var/obj/map_metadata/train_raid/M = map
	if (!istype(M)) return
	for (var/id in M.crews)
		var/datum/train_raid_crew/C = M.crews[id]
		for (var/key in C.beds)
			if (C.beds[key] == src)
				to_chat(user, "It is claimed by a [C.title] crew raider.")
				return
	to_chat(user, "Nobody has claimed it.")

/obj/structure/bed/train_raid/Destroy()
	var/obj/map_metadata/train_raid/M = map
	if (istype(M))
		for (var/id in M.crews)
			var/datum/train_raid_crew/C = M.crews[id]
			C.release_bed(src)
	return ..()

// One loot pad rolls one table for its section tier onto its tile; items
// land inside a crate on the same tile when there is one.
/obj/effect/train_raid_loot
	name = "loot pad"
	icon = 'icons/misc/mark.dmi'
	icon_state = "dice"
	invisibility = 101
	anchored = TRUE
	density = FALSE
	var/tier = 1
	var/tmp/rolled = FALSE

/obj/effect/train_raid_loot/New()
	..()
	train_raid_loot_pads |= src
	spawn(2)
		roll_loot()

/obj/effect/train_raid_loot/Destroy()
	train_raid_loot_pads -= src
	return ..()

/obj/effect/train_raid_loot/proc/tables()
	switch (tier)
		if (1) return list(null, null, /obj/effect/spawner/lootdrop/melee, /obj/effect/spawner/lootdrop/accessories, /obj/random/medical/bandage, /obj/random/melee)
		if (2) return list(null, null, /obj/effect/spawner/lootdrop/ammo/industrial, /obj/effect/spawner/lootdrop/armor/industrial, /obj/random/medical/drugs, /obj/effect/spawner/lootdrop/melee, /obj/random/medical/bandage)
		if (3) return list(null, /obj/effect/spawner/lootdrop/guns/industrial, /obj/effect/spawner/lootdrop/ammo/industrial, /obj/random/magazine/western_random, /obj/item/weapon/storage/eft/medical, /obj/item/train_raid_balloon, /obj/random/armor)
		if (4) return list(null, /obj/effect/spawner/lootdrop/guns, /obj/effect/spawner/lootdrop/armor, /obj/effect/spawner/lootdrop/explosives, /obj/random/gun/western_random, /obj/random/accessories, /obj/item/train_raid_balloon)
	return list(/obj/effect/spawner/lootdrop/guns, /obj/effect/spawner/lootdrop/armor, /obj/effect/spawner/lootdrop/explosives, /obj/random/gun/ak_modern, /obj/random/magazine/western_random, /obj/item/train_raid_balloon, /obj/item/train_raid_balloon)

/obj/effect/train_raid_loot/proc/roll_loot()
	if (rolled || !isturf(loc)) return FALSE
	rolled = TRUE
	var/path = pick(tables())
	if (!path) return TRUE
	var/list/before = list()
	for (var/atom/movable/A in loc)
		before[A] = TRUE
	new path(loc)
	var/obj/structure/closet/C = locate() in loc
	if (C)
		for (var/obj/item/I in loc)
			if (!before[I]) I.forceMove(C)
	return TRUE

///////////////////////////////Items//////////////////////////////////////////////

// A lift balloon sends one item or crate from the Hauler to the crew's stores.
/obj/item/train_raid_balloon
	name = "lift balloon"
	desc = "A folded gas balloon with a cargo sling. Use it on an item or crate on the Hauler to send that load up to your shuttle's stores. One use."
	icon = 'icons/obj/materials.dmi'
	icon_state = "rope"
	w_class = ITEM_SIZE_SMALL
	value = 15

/obj/item/train_raid_balloon/afterattack(atom/target, mob/user, proximity)
	if (!proximity) return
	var/mob/living/human/H = user
	var/obj/map_metadata/train_raid/M = map
	if (!istype(H) || !istype(M) || M.game_over) return
	var/datum/train_raid_crew/C = M.crew_of(H)
	if (!C)
		to_chat(H, "You are not part of a shuttle crew.")
		return
	var/atom/movable/load = target
	if (!istype(load) || !isturf(load.loc) || ismob(load) || (!istype(load, /obj/item) && !istype(load, /obj/structure/closet)))
		to_chat(H, "The sling only takes an item or a crate lying on the floor.")
		return
	if (!M.on_hauler(load))
		to_chat(H, "The balloon only lifts loads from the Hauler or the station.")
		return
	var/list/stores = C.store_turfs()
	if (!stores.len)
		to_chat(H, "Your shuttle has no stores to receive the load.")
		return
	H.visible_message(SPAN_NOTICE("[H] rigs a lift balloon to [load]."), SPAN_NOTICE("You rig the balloon to [load]. Hold on for ten seconds while it fills."))
	if (!do_after(H, 10 SECONDS, load, FALSE, can_move = FALSE)) return
	if (QDELETED(load) || !isturf(load.loc) || !M.on_hauler(load) || M.game_over || !H.Adjacent(load)) return
	var/turf/T = pick(stores)
	load.forceMove(T)
	H.visible_message(SPAN_NOTICE("The balloon lifts [load] away toward the [C.title] shuttle."), SPAN_NOTICE("The balloon carries [load] to your shuttle's stores."))
	C.announce("[H.real_name] sent [load] up to the stores.")
	qdel(src)

// The shuttle beacon recalls the crew's shuttle from the Hauler.
/obj/item/train_raid_beacon
	name = "shuttle beacon"
	desc = "A signal beacon tuned to your crew's shuttle. Use it in your hand on the Hauler to call the shuttle back to the station."
	icon = 'icons/obj/lighting.dmi'
	icon_state = "flare"
	w_class = ITEM_SIZE_SMALL
	value = 5

/obj/item/train_raid_beacon/attack_self(mob/user)
	var/mob/living/human/H = user
	var/obj/map_metadata/train_raid/M = map
	if (!istype(H) || !istype(M)) return
	var/datum/train_raid_crew/C = M.crew_of(H)
	if (!C)
		to_chat(H, "The beacon is not tuned to any shuttle you belong to.")
		return
	C.recall(H)

