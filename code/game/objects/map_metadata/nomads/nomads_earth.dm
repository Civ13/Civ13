// The Earth-shaped continents (docs/earth-continents.md): Europe, the
// Mediterranean, Asia and Africa in place of the older Desert and Jungle lands, and the island lands
// reached only by sea or air: Oceania, Greenland and Antarctica. Both maps are generated by
// tests/earth_maps/generate.py from hand-placed outlines, ranges, rivers and
// climates, the way the two Americas regions are. Each is one surface level;
// mountains are surface rock, and like every single-level map they get an
// unformed underground at boot (dug_underground.dm).
// Which map edges lead on to which land, and which edges face open sea, are
// in tools/world_links/world_links.json (docs/world-links.md), by region id.
/obj/map_metadata/nomads/earth_europe
	ID = MAP_NOMADS_EARTH_EUROPE
	// The sun's path (sun_shadows.dm): degrees north.
	sun_latitude = 50
	world_longitude = 10 // world calendar time zone (world_calendar.dm)
	world_region = "europe" // its id in world_links (weather_shared.dm)
	// Cinnabar on an old mercury belt: twice as common (mercury.dm).
	cinnabar_rich = TRUE
	title = "Nomads (Europe)"
	description = "Europe north of the inner sea, from the Atlantic shore to the Urals and the northern ice."
	research_active = TRUE
	// Hills: per-tile heights for the surface, z 1 (docs/terrain-height.md).
	terrain_height_file = "maps/heights/nomads_earth_europe.txt"
	// The wildlife and wild plant caps scale with the walkable land, short of
	// in proportion.
	ecology_wildlife_cap = 570
	wild_plant_cap = 315
	new_player_start_z = 1
	// The standing open-air level aircraft fly on, and nine storeys above it (building_admission.dm).
	building_levels = 10
	building_level_standing = TRUE
	// Mined-out mountain floor keeps giving stone and regrowing ore seams (mountain_seams.dm).
	mountain_seams = TRUE

