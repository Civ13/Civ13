// The Earth-shaped continents (docs/earth-continents.md): Europe, and Africa
// in place of the older Desert and Jungle lands. Both maps are generated by
// tests/earth_maps/generate.py from hand-placed outlines, ranges, rivers and
// climates, the way the two Americas regions are. Each is one surface level;
// mountains are surface rock, and like every single-level map they get an
// unformed underground at boot (dug_underground.dm).
/obj/map_metadata/nomads/earth_europe
	ID = MAP_NOMADS_EARTH_EUROPE
	// The sun's path (sun_shadows.dm): degrees north.
	sun_latitude = 50
	// Cinnabar on an old mercury belt: twice as common (mercury.dm).
	cinnabar_rich = TRUE
	title = "Nomads (Europe)"
	description = "Europe and the lands around the inner sea, from the northern ice to the desert's edge."
	research_active = TRUE
	// Hills: per-tile heights for the surface, z 1 (docs/terrain-height.md).
	terrain_height_file = "maps/heights/nomads_earth_europe.txt"
	// About three times Gaia's walkable land: the wildlife and wild plant caps
	// scale with it, short of in proportion.
	ecology_wildlife_cap = 1000
	wild_plant_cap = 550
	// The steppe runs on over the east edge into Asia (region_edge.dm).
	edge_crossings = list("east" = "asia")
	// Open sea along these edges, best first (sea_lanes.dm): ships make landfall there.
	sea_coasts = list("W", "N")
	new_player_start_z = 1
	// The standing open-air level aircraft fly on, and nine storeys above it (building_admission.dm).
	building_levels = 10
	building_level_standing = TRUE
	// Mined-out mountain floor keeps giving stone and regrowing ore seams (mountain_seams.dm).
	mountain_seams = TRUE

/obj/map_metadata/nomads/earth_africa
	ID = MAP_NOMADS_EARTH_AFRICA
	// The sun's path (sun_shadows.dm): the land lies across the equator.
	sun_latitude = 5
	title = "Nomads (Africa)"
	description = "Africa from the inner sea to the southern cape, with the desert peninsula to its east."
	research_active = TRUE
	terrain_height_file = "maps/heights/nomads_earth_africa.txt"
	ecology_wildlife_cap = 1100
	wild_plant_cap = 600
	// The desert peninsula in the north-east runs on into Asia (region_edge.dm).
	edge_crossings = list("east" = list("asia" = list(0.68, 1)))
	sea_coasts = list("W", "S", "E")
	new_player_start_z = 1
	building_levels = 10
	building_level_standing = TRUE
	mountain_seams = TRUE
