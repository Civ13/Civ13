// The Americas: two large Nomads regions, a northern and a southern continent,
// one land mass split at the isthmus: players walk over the shared map edge
// (code/modules/persistence/region_edge.dm, docs/americas-regions.md).
// Both maps are generated by tests/americas_maps/build.py; each is one surface
// level. Like every single-level map they get an unformed underground at boot
// (dug_underground.dm), under the standing open-air level's slot.
// Which map edges lead on to which land, and which edges face open sea, are
// in tools/world_links/world_links.json (docs/world-links.md), by region id.
/obj/map_metadata/nomads/americas_north
	ID = MAP_NOMADS_AMERICAS_NORTH
	// The sun's path (sun_shadows.dm): degrees north.
	sun_latitude = 35
	// Cinnabar on an old mercury belt: twice as common (mercury.dm).
	cinnabar_rich = TRUE
	title = "Nomads (Northern Americas)"
	description = "A northern continent from the ice to the isthmus."
	research_active = TRUE
	// Hills: per-tile heights for the surface, z 1 (docs/terrain-height.md).
	terrain_height_file = "maps/heights/nomads_americas_north.txt"
	// About three times Gaia's walkable land (four in the south): the wildlife
	// and wild plant caps scale with it, short of in proportion.
	ecology_wildlife_cap = 1000
	wild_plant_cap = 550
	new_player_start_z = 1
	// The standing open-air level aircraft fly on, and nine storeys above it (building_admission.dm).
	// Each of these million-cell planes adds about 130 MiB to a reload once built.
	building_levels = 10
	building_level_standing = TRUE
	// Mined-out mountain floor keeps giving stone and regrowing ore seams (mountain_seams.dm).
	mountain_seams = TRUE

/obj/map_metadata/nomads/americas_south
	ID = MAP_NOMADS_AMERICAS_SOUTH
	// The sun's path (sun_shadows.dm): degrees south, so the noon sun stands in the north.
	sun_latitude = -20
	// Cinnabar on an old mercury belt: twice as common (mercury.dm).
	cinnabar_rich = TRUE
	title = "Nomads (Southern Americas)"
	description = "A southern continent from the isthmus to the cold cape."
	research_active = TRUE
	terrain_height_file = "maps/heights/nomads_americas_south.txt"
	ecology_wildlife_cap = 1200
	wild_plant_cap = 650
	new_player_start_z = 1
	// The standing open-air level aircraft fly on, and nine storeys above it (building_admission.dm).
	// Each of these million-cell planes adds about 130 MiB to a reload once built.
	building_levels = 10
	building_level_standing = TRUE
	// Mined-out mountain floor keeps giving stone and regrowing ore seams (mountain_seams.dm).
	mountain_seams = TRUE
