// The Americas: two large Nomads regions, a northern and a southern continent,
// joined by the isthmus trail at the foot of the north (docs/americas-regions.md).
// Both maps are generated by tests/americas_maps/build.py; each is one surface
// level. Mountains are rock to mine at ground level, so neither map needs an
// underground level.
/obj/map_metadata/nomads/americas_north
	ID = MAP_NOMADS_AMERICAS_NORTH
	title = "Nomads (Northern Americas)"
	description = "A northern continent from the ice to the isthmus."
	research_active = TRUE
