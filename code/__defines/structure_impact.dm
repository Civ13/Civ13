// Kinds of force structure_impact() takes (code/game/objects/structure_impact.dm).
// Crush: a vehicle, a crashing aircraft or falling masonry. What a part is made
// of decides how much of the force it shrugs off.
#define IMPACT_CRUSH "crush"
// Raw: a blow whose numbers were already tuned against each part's health (the
// siege ram, catapult and undermining). Material does not scale it again.
#define IMPACT_RAW "raw"
