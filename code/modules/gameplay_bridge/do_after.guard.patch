 	while (world.time < endtime)
 		sleep(0.1)
+#ifdef CIV13_GAMEPLAY_BRIDGE
+		if (gameplay_lease && !gameplay_lease.valid())
+			. = FALSE
+			break
+#endif
 		if (progress)
 			progbar.update(world.time - starttime)
 
@@ -227,6 +240,10 @@
 
 	if (progbar)
 		qdel(progbar)
