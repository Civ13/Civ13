{
  "schema_version": 1,
  "status": "implemented_for_synthetic_inputs_only",
  "policy_id": "static-map-v0",
  "source_commit": "fa363b8a01ed7d936c10a6303ce1be4c26d82ab0",
  "match": "exact_type_only",
  "unknown_terrain": "reject",
  "unknown_static_object": "incomplete_preview_only",
  "unknown_field": "unsupported_record_refuse_or_incomplete_preview",
  "terrain": {
    "/turf/floor/wood": {"fields": {}, "requires": "default_flooring_proven"},
    "/turf/wall/iron": {"fields": {}, "requires": "default_material_proven"}
  },
  "structures": {
    "/obj/structure/bed/chair": {
      "fields": {
        "dir": {"kind": "integer_enum", "values": [1, 2, 4, 8]},
        "pixel_x": {"kind": "integer_range", "minimum": -32, "maximum": 32},
        "pixel_y": {"kind": "integer_range", "minimum": -32, "maximum": 32}
      },
      "requires": "default_material_and_padding_proven",
      "contents": "exclude_transitively_with_report"
    }
  },
  "areas": {"/area/caribbean/dark": {"fields": {}, "provenance": "pinned_base_dmm"}},
  "spawns": {
    "/obj/effect/landmark": {
      "fields": {"name": {"kind": "authored_token", "values": ["JoinLateCivilian"]}},
      "provenance": "pinned_base_dmm_and_reviewed_job_profile"
    }
  },
  "exclusions": ["mobs", "player_identity", "credentials", "runtime_state", "user_text", "nested_contents", "arbitrary_datum_graphs", "executable_values"],
  "native_acceptance": "not_run"
}
