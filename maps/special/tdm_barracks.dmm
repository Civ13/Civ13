"gx" = (/obj/structure/sign/custom/plaque{name = "Fire and rescue"; desc = "Hard landings break wheels and hurt nobody here. Patch up, then call a fresh plane from a hangar; wrecks and stranded planes are cleared away by the tower."},/turf/floor/plating/concrete,/area/caribbean/barracks/annex/airfield)
"gy" = (/obj/structure/sign/custom/plaque{name = "Control tower"; desc = "Click the flight board for who is up, the sky-lap times and to clear stranded aircraft. The runway runs south from the north holding point; land southbound over the north threshold."},/turf/floor/plating/tiled/dark,/area/caribbean/barracks/annex/airfield)
