/world/New()
	text2file(json_encode(list("commit" = world.params["tested_commit"], "byond_version" = world.byond_version, "byond_build" = world.byond_build, "maxx" = world.maxx, "maxy" = world.maxy, "maxz" = world.maxz)), "metadata.json")
	try
		var/list/recipes = list(new /datum/chemical_reaction/ethylene, new /datum/chemical_reaction/propylene, new /datum/chemical_reaction/titaniumchloride, new /datum/chemical_reaction/aluminumchloride, new /datum/chemical_reaction/borontrifluoride)
		for(var/datum/chemical_reaction/reaction in recipes)
			var/datum/reagents/holder = new(1000)
			for(var/id in reaction.required_reagents)
				chemistry_assert(holder.add_reagent(id, reaction.required_reagents[id], safety = TRUE), "Missing input [id]")
			chemistry_assert(reaction.can_happen(holder), "Recipe unavailable: [reaction.id]")
			reaction.process(holder)
			chemistry_assert(holder.get_reagent_amount(reaction.result) == reaction.result_amount, "Product missing: [reaction.id]")
			for(var/id in reaction.required_reagents)
				chemistry_assert(holder.get_reagent_amount(id) == 0, "Input not consumed: [id]")
		var/datum/chemical_reaction/polyethylene/polymer = new
		var/datum/reagents/mixture = new(1000)
		mixture.add_reagent("ethylene", 4, safety = TRUE)
		chemistry_assert(!polymer.can_happen(mixture), "Polymerization proceeded without catalysts")
		for(var/id in polymer.catalysts)
			mixture.add_reagent(id, polymer.catalysts[id], safety = TRUE)
		chemistry_assert(polymer.can_happen(mixture), "Polymerization unavailable with catalysts")
		polymer.process(mixture)
		chemistry_assert(mixture.get_reagent_amount("polyethylene") == 50, "Incorrect scaled polymer yield")
		chemistry_assert(mixture.get_reagent_amount("ethylene") == 0, "Ethylene not consumed")
		for(var/id in polymer.catalysts)
			chemistry_assert(mixture.get_reagent_amount(id) == polymer.catalysts[id], "Catalyst consumed: [id]")
		mixture.add_reagent("propylene", 2, safety = TRUE)
		chemistry_assert(!polymer.can_happen(mixture), "Propylene incorrectly accepted")
		chemistry_prepare_visual()
		if(!world.params["visual"])
			chemistry_run_visual()
		text2file("PASS: precursor recipes, catalyst rejection, scaled yield, catalyst retention, propylene rejection", "chemistry_result.txt")
	catch(var/exception/error)
		text2file("FAIL: [error]", "chemistry_result.txt")
	if(!world.params["visual"] || findtext(file2text("chemistry_result.txt"), "PASS:") != 1)
		del(world)

/proc/chemistry_assert(condition, message)
	if(!condition)
		throw EXCEPTION(message)
