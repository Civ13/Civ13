/world/New()
	text2file(json_encode(list("commit" = world.params["tested_commit"], "probe" = "fuel", "byond_version" = world.byond_version, "byond_build" = world.byond_build, "maxx" = world.maxx, "maxy" = world.maxy, "maxz" = world.maxz)), "metadata.json")
	try
		var/list/recipes = list(new /datum/chemical_reaction/octane, new /datum/chemical_reaction/cyclopentane, new /datum/chemical_reaction/toluene, new /datum/chemical_reaction/butene)
		for(var/datum/chemical_reaction/recipe in recipes)
			var/datum/reagents/holder = new(1000)
			for(var/id in recipe.required_reagents)
				chemistry_assert(holder.add_reagent(id, recipe.required_reagents[id], safety = TRUE), "Missing input [id]")
			chemistry_assert(recipe.can_happen(holder), "Recipe unavailable: [recipe.id]")
			recipe.process(holder)
			chemistry_assert(holder.get_reagent_amount(recipe.result) == recipe.result_amount, "Product missing: [recipe.id]")
			for(var/id in recipe.required_reagents)
				chemistry_assert(holder.get_reagent_amount(id) == 0, "Input not consumed: [id]")
		fuel_prepare_visual()
		if(!world.params["visual"])
			fuel_run_visual()
		text2file("PASS: four fuel precursor recipes, scaled gasoline yield, missing ingredient and insufficient ingredient rejection", "chemistry_result.txt")
	catch(var/exception/error)
		text2file("FAIL: [error]", "chemistry_result.txt")
	if(!world.params["visual"] || findtext(file2text("chemistry_result.txt"), "PASS:") != 1)
		del(world)

/proc/chemistry_assert(condition, message)
	if(!condition)
		throw EXCEPTION(message)
