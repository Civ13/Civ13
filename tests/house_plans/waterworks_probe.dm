// Runs inside the existing isolated house-planner fixture.
/datum/terrain_heights/waterworks_probe
	var/list/levels = list("1,2" = 3, "3,2" = 1, "4,2" = 3, "3,6" = 2)

/datum/terrain_heights/waterworks_probe/at(x, y, z)
	return levels["[x],[y]"] || 0

/proc/waterworks_probe()
	var/datum/waterworks_plan/D = waterworks_plan_from_code("C13WATER/1/Town_supply/A/1,1,I;2,1,A;3,1,C;4,1,U")
	house_assert(D && D.name == "Town supply" && D.to_code() == "C13WATER/1/Town_supply/A/1,1,I;2,1,A;3,1,C;4,1,U", "waterworks code keeps the ordered route")
	house_assert(!waterworks_plan_from_code("C13WATER/1/x/A/0,1,I"), "waterworks refuses an off-grid tile")
	house_assert(!waterworks_plan_from_code("C13WATER/1/x/A/1,1,I;1,1,C"), "waterworks refuses duplicate tiles")
	house_assert(!waterworks_plan_from_code("C13WATER/1/x/A/1,1,D"), "waterworks refuses a sewer piece on an aqueduct")
	var/datum/waterworks_plan/gap = waterworks_plan_from_code("C13WATER/1/x/A/1,1,I;2,2,C;3,2,U")
	var/datum/design_report/R = gap.check_design()
	house_assert(R.blocked(), "a diagonal gap cannot be pegged")
	qdel(R)
	qdel(gap)

	map.persistence = TRUE
	map.terrain_height_file = "waterworks-probe"
	map.terrain_heights_cache = new /datum/terrain_heights/waterworks_probe
	new /turf/floor/beach/water(locate(1, 2, 1))
	var/turf/origin = locate(2, 2, 1)
	var/turf/low = locate(3, 2, 1)
	var/turf/rise = locate(4, 2, 1)
	var/turf/fountain = locate(5, 2, 1)
	var/list/seen = range(7, origin)
	R = D.check_design()
	D.check_site(origin, R, seen)
	house_assert(!R.blocked(), "an arch preserves head across a dip, letting water reach the next channel")
	qdel(R)
	var/datum/waterworks_plan/pipe = waterworks_plan_from_code("C13WATER/1/x/A/1,1,I;2,1,P;3,1,C;4,1,V")
	R = pipe.check_design()
	pipe.check_site(origin, R, seen)
	house_assert(!R.blocked(), "a buried pipe also preserves the head through the dip to a cistern")
	qdel(R)
	qdel(pipe)
	var/list/parts_before = D.materials(origin, seen)
	house_assert(parts_before["stone"] == 17, "the site quote includes four exact unbuilt recipes")
	house_assert(D.peg_out(origin, "waterworks-probe", seen) == 4, "a grade-checked aqueduct leaves four nonbuilding pegs")
	var/list/unseen = seen.Copy()
	unseen -= locate(1, 2, 1)
	R = D.check_design()
	D.check_site(origin, R, unseen)
	house_assert(R.blocked() && findtext(jointext(R.texts(DESIGN_ERROR), " "), "outside your survey"), "an unseen bank refuses without revealing its water")
	qdel(R)
	house_assert(isnull(D.peg_out(origin, "waterworks-probe", unseen)) && length(build_markers_of("waterworks-probe")) == 4, "unseen bank leaves existing pegs intact")
	house_assert(!(locate(/obj/structure/aqueduct) in low), "pegging does not create a channel")
	var/datum/waterworks_plan/blocked = waterworks_plan_from_code("C13WATER/1/x/A/1,1,I;2,1,C;3,1,C;4,1,U")
	R = blocked.check_design()
	blocked.check_site(origin, R, seen)
	house_assert(R.blocked(), "an open channel drops the head, so the same rise blocks the route")
	qdel(R)
	house_assert(isnull(blocked.peg_out(origin, "waterworks-probe", seen)) && length(build_markers_of("waterworks-probe")) == 4, "failed re-staging leaves the prior pegs intact")
	house_assert(isnull(D.peg_out(locate(world.maxx, 2, 1), "waterworks-probe", range(7, locate(world.maxx, 2, 1)))), "a plan that runs off the map is refused")
	var/obj/structure/aqueduct/flume/wrong = new(low)
	build_markers_left("waterworks-probe")
	house_assert(length(build_markers_of("waterworks-probe")) == 4, "a wrong raised piece does not fulfill the specific arch peg")
	qdel(wrong)
	new /obj/structure/aqueduct_intake(origin)
	new /obj/structure/aqueduct/arch(low)
	new /obj/structure/aqueduct/channel(rise)
	var/obj/structure/sink/aqueduct_fountain/F = new(fountain)
	build_markers_left("waterworks-probe")
	house_assert(!length(build_markers_of("waterworks-probe")) && !length(D.materials(origin, seen)), "exact constructed parts clear every peg and the material quote")
	aqueduct_last_flow = -1000
	aqueduct_flow_all()
	house_assert(F.volume > 0, "the ordinary aqueduct tick feeds the constructed fountain")

	var/turf/sewer_origin = locate(2, 6, 1)
	new /turf/floor/beach/water(locate(5, 6, 1))
	seen = range(7, sewer_origin)
	var/datum/waterworks_plan/S = waterworks_plan_from_code("C13WATER/1/Town_sewer/S/1,1,D;2,1,B;3,1,O")
	R = S.check_design()
	S.check_site(sewer_origin, R, seen)
	var/warnings = jointext(R.texts(DESIGN_WARNING), " ")
	house_assert(!R.blocked() && findtext(warnings, "uphill") && findtext(warnings, "Freshwater discharge"), "sewer uphill and potable water are visible advisories, not invented runtime rules")
	qdel(R)
	house_assert(S.peg_out(sewer_origin, "waterworks-sewer", seen) == 3, "a workable route stages an inlet, brick sewer and ordinary shore drain")
	var/obj/structure/sewer_piece/drain/floor/inlet = new(sewer_origin)
	new /obj/structure/sewer_piece/drain/brick(locate(3, 6, 1))
	var/obj/structure/sewer_piece/drain/stone/outfall = new(locate(4, 6, 1))
	house_assert(outfall.outfall_dir() == EAST && floor_drain_route(inlet), "the ordinary sewer route reaches its outfall")
	build_markers_left("waterworks-sewer")
	house_assert(!length(build_markers_of("waterworks-sewer")), "all the sewer pegs clear on construction")

	new /turf/floor/beach/water(locate(3, 7, 1))
	seen = range(7, sewer_origin)
	R = S.check_design()
	S.check_site(sewer_origin, R, seen)
	house_assert(R.blocked(), "an earlier link beside water would discharge before the planned outfall")
	qdel(R)
	qdel(S)
	qdel(blocked)
	qdel(D)
