window "smoke"
    elem "smoke"
        type = MAIN
        statusbar = false
        pos = 80,80
        size = 224x224
        title = "Civ13 DreamSeeker smoke"
        can-resize = false
    elem "map"
        type = MAP
        pos = 0,0
        size = 224x224
        zoom = 1
        zoom-mode = normal
        letterbox = true
        is-default = true
