// Real renderer contracts in the existing isolated Atlas fixture. No game clients.
/proc/check_resource_search(mob/viewer)
	var/datum/crafting_atlas_reference/reference = new
	reference.load_attempted = TRUE
	reference.resources = list("proteolytic_enzyme" = list("name" = "proteolytic enzyme"), "orphan_id" = list("name" = "Orphan resource"))
	reference.catalog = list("acquisition" = list("proteolytic_enzyme" = list(list("name" = "Biological extraction kit", "steps" = list("Use an empty extraction kit on a vomit decal")))))
	reference.recipes = list()
	for (var/i in 1 to 2)
		// Same name, distinct recipes. A resource with this name is a third identity.
		reference.recipes += list(list("id" = "enzyme_recipe_[i]", "name" = "proteolytic enzyme", "kind" = "Fixture", "searchable" = "proteolytic enzyme proteolytic_enzyme", "inputs" = list(), "outputs" = list(list("id" = "proteolytic_enzyme", "name" = "proteolytic enzyme", "quantity" = "[i]")), "unlock_eras" = list(0), "era_label" = "Stone Age"))
	for (var/query in list("proteolytic_enzyme", "proteolytic enzyme", "PROTEOLYTIC_ENZYME", "  proteolytic  enzyme  ", "proteolytic[ascii2text(9)]enzyme"))
		var/list/matches = reference.matching_resources(query)
		check_atlas(matches.len == 1 && matches[1] == "proteolytic_enzyme", "resource name identifier and whitespace search")
		var/view = reference.graph_html(viewer, query)
		check_atlas(findtext(view, "2 matching recipes") && findtext(view, "1 matching resources"), "resource and distinct recipe counts")
		check_atlas(findtext(view, "data-result-type='resource'") && findtext(view, "data-result-type='recipe'"), "resource and recipe result types")
		check_atlas(findtext(view, "atlas_resource=proteolytic%5fenzyme") || findtext(view, "atlas_resource=proteolytic_enzyme"), "resource direct canonical navigation")
		check_atlas(findtext(view, "atlas_recipe=enzyme_recipe_") || findtext(view, "atlas_recipe=enzyme%5frecipe%5f"), "distinct recipe navigation preserved")
	var/restricted = reference.graph_html(viewer, "proteolytic enzyme", era = "8", processor = "sawmill")
	check_atlas(findtext(restricted, "0 matching recipes") && findtext(restricted, "1 matching resources") && findtext(restricted, "data-result-type='resource'"), "recipe filters do not hide resource results")
	// The existing atlas_resource Topic calls show(viewer, resource_id, 1, resource_id),
	// omitting era/processor/recipe state. Render that same argument set without a client.
	var/direct = reference.render_html(viewer, "proteolytic_enzyme", 1, "proteolytic_enzyme")
	check_atlas(findtext(direct, "Use an empty extraction kit on a vomit decal") && findtext(direct, "2 matching recipes"), "direct resource acquisition and related recipe navigation")
	check_atlas(reference.resources["proteolytic_enzyme"]["name"] == "proteolytic enzyme", "resource label and canonical identity unchanged")
	var/no_match = reference.graph_html(viewer, "missing")
	check_atlas(findtext(no_match, "0 matching resources") && !findtext(no_match, "data-result-type='resource'") && !findtext(no_match, "Biological extraction kit"), "resource no-match has no stale guidance")
	var/list/empty_matches = reference.matching_resources(" _ [ascii2text(9)] ")
	check_atlas(!empty_matches.len && findtext(reference.graph_html(viewer, "  "), "2 matching recipes"), "normalized empty query keeps recipe browsing")
	check_atlas(findtext(reference.graph_html(viewer, "orphan_id"), "Orphan resource"), "resource without related recipes remains searchable")
	check_atlas(!reference.resource_exists("missing"), "unknown direct resource remains rejected")
	reference.resources = list()
	for (var/i in 1 to 151)
		reference.resources["bounded_[i]"] = list("name" = "Bounded resource [i]")
	var/bounded = reference.graph_html(viewer, "bounded")
	check_atlas(findtext(bounded, "151 matching resources") && findtext(bounded, "Bounded resource 150</a>") && !findtext(bounded, "Bounded resource 151</a>"), "resource result bound is independent of recipe bound")
	reference.resources["escaped"] = list("name" = "<script>unsafe</script>")
	var/escaped = reference.graph_html(viewer, "unsafe")
	check_atlas(!findtext(escaped, "<script>") && findtext(escaped, "&lt;script&gt;"), "resource result labels are escaped")
