/world/New()
	OpenPort("none")
	check_atlas(!world.port && !OpenPort(12345), "fixture refuses listening ports")
	text2file("closed", "port-closed.txt")
	var/mob/viewer = new
	check_navigation(viewer)
	check_atlas(crafting_atlas_reference.load_catalog(), "full production catalog load")
	check_atlas(crafting_atlas_reference.recipes.len == ATLAS_EXPECTED_RECIPES, "all current records loaded")
	var/first_page = crafting_atlas_reference.page_html(viewer)
	check_atlas(findtext(first_page, "Next"), "full catalog bounded navigation")
	var/assembly_page = crafting_atlas_reference.page_html(viewer, "Finish Flintlock pistol assembly")
	check_atlas(findtext(assembly_page, "1 matching recipes"), "exact component route searchable")
	check_atlas(findtext(assembly_page, "flint-loaded mechanism") && findtext(assembly_page, "pistol stock with barrel"), "stateful prerequisites render")
	var/twine_guidance = crafting_atlas_reference.acquisition_html("/obj/item/stack/crude_twine")
	check_atlas(findtext(twine_guidance, "Twist crude twine") && findtext(twine_guidance, "grass_cuttings"), "full catalog acquisition processing chain")
	var/iron_guidance = crafting_atlas_reference.acquisition_html("/obj/item/stack/ore/iron")
	check_atlas(findtext(iron_guidance, "Powered soil sifter") && findtext(iron_guidance, "150"), "full catalog source restriction rendering")
	check_atlas(constructed_items == 0, "full catalog no item constructors")
	var/sawmill = crafting_atlas_reference.render_html(viewer, processor = "sawmill")
	check_atlas(findtext(sawmill, "3 matching recipes") && findtext(sawmill, "nominal") && findtext(sawmill, "skill failure"), "full production sawmill conversions")
	var/grain = crafting_atlas_reference.render_html(viewer, processor = "grain_mill")
	check_atlas(findtext(grain, "8 matching recipes") && findtext(grain, "grain item") && findtext(grain, "stamina"), "full production grain conversions")
	var/tanning = crafting_atlas_reference.render_html(viewer, processor = "tanning_rack")
	check_atlas(findtext(tanning, "1 matching recipes") && findtext(tanning, "resource_processing") && findtext(tanning, "300 ticks"), "full production tanning rack and construction research")
	var/turkey = crafting_atlas_reference.page_html(viewer, "Harvest adult turkey hen skin")
	check_atlas(findtext(turkey, "1 matching recipes") && findtext(turkey, "raw hide") && findtext(turkey, "chicks give no hide"), "full catalog adult turkey skin route")
	var/tannin = crafting_atlas_reference.acquisition_html("tannin")
	check_atlas(findtext(tannin, "Extract bark tannin") && findtext(tannin, "10 water") && findtext(tannin, "10 tannin"), "full catalog tannin acquisition quantities")
	var/leather = crafting_atlas_reference.acquisition_html("/material/leather")
	check_atlas(findtext(leather, "Tan a dry hide into leather") && !findtext(leather, "Butcher large mammals"), "full catalog no direct animal leather route")
	if (!atlas_failed)
		text2file("PASS", "passed.txt")
	del(world)

/world/OpenPort(port)
	if (port == "none")
		return ..()
	return FALSE
