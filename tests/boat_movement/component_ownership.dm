// Exercise real attachment and synchronous qdel cleanup, including replacement slots.
/datum/boat_game_probe/proc/test_component_ownership()
	phase = "movement component ownership"
	var/turf/T = locate(55,40,1)
	var/obj/structure/vehicleparts/axis/A = new(T)
	var/obj/structure/vehicleparts/frame/F = new(T)
	F.axis = A
	A.corners = list(F, null, null, null)
	var/obj/structure/vehicleparts/movement/old_wheel = new(T)
	var/obj/structure/vehicleparts/movement/new_wheel = new(T)
	old_wheel.MouseDrop(F)
	old_wheel.MouseDrop(F)
	new_wheel.MouseDrop(F)
	check(F.mwheel == new_wheel && (old_wheel in A.wheels) && (new_wheel in A.wheels), "wheel replacement setup")
	qdel(old_wheel)
	check(F.mwheel == new_wheel && !(old_wheel in A.wheels) && (new_wheel in A.wheels), "old wheel cleanup preserves replacement")
	qdel(new_wheel)
	check(!F.mwheel && !A.wheels.len, "current wheel cleanup clears registry and slot")
	qdel(F)
	qdel(A)

	var/obj/structure/vehicleparts/axis/ship/S = new(T)
	var/obj/structure/vehicleparts/frame/ship/SF = new(T)
	SF.axis = S
	var/obj/structure/vehicleparts/movement/sail/old_mast = new(T)
	var/obj/structure/vehicleparts/movement/sail/new_mast = new(T)
	old_mast.MouseDrop(SF)
	old_mast.MouseDrop(SF)
	new_mast.MouseDrop(SF)
	check(SF.mwheel == new_mast && (old_mast in S.masts) && (new_mast in S.masts), "mast replacement setup")
	qdel(old_mast)
	check(SF.mwheel == new_mast && !(old_mast in S.masts) && (new_mast in S.masts), "old mast cleanup preserves replacement")
	qdel(new_mast)
	check(!SF.mwheel && !S.masts.len && !S.check_engine(), "last mast cleanup removes sail power")
	qdel(SF)
	qdel(S)
