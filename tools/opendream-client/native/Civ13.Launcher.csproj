<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Civ13</AssemblyName>
    <Version>1.5.3</Version>
    <Company>Civ13</Company>
    <Product>Civ13 Launcher</Product>
    <Description>Portable Civ13 launcher with verified client and launcher updates</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- Build.ps1 publishes with -p:Civ13Gui=true for the launcher window. Test projects reference
       the plain net8.0 build, so their offline restores never need the Windows desktop packs. -->
  <PropertyGroup Condition="'$(Civ13Gui)' == 'true'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);CIV13_GUI</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Updater.cs" />
    <Compile Include="Byond.cs" />
    <Compile Include="ByondStatus.cs" />
    <Compile Include="TopicPacing.cs" />
    <Compile Include="Connection.cs" />
    <Compile Include="ServerCatalog.cs" />
    <Compile Include="ServerStatus.cs" />
    <Compile Include="HostStatus.cs" />
    <Compile Include="ServerBrowser.cs" />
    <Compile Include="CommunityLinks.cs" />
    <Compile Include="LocalDreamDaemon.cs" />

    <Compile Include="LocalHosting.cs" />
    <Compile Include="HostSettings.cs" />
    <Compile Include="LocalBot.cs" />
    <Compile Include="LocalHelp.cs" />
    <Compile Include="DiscordPresence.cs" />
    <Compile Include="DiscordSignIn.cs" />
    <Compile Include="Social/*.cs" />
    <Compile Include="Management/*.cs" />
    <Compile Include="Gui/*.cs" Condition="'$(Civ13Gui)' == 'true'" />
    <!-- Compiled in directly: a self-contained -r win-x64 restore would otherwise need runtime packs for the offline server-management feed. -->
    <Compile Include="../../server-management/Core/*.cs" />
    <!-- Offline fixtures construct clock-bound proofs without DNS or sockets. -->
    <InternalsVisibleTo Include="Civ13.Launcher.SocialContracts" />
    <EmbeddedResource Include="../../byond/version.json" LogicalName="byond.json" />
  </ItemGroup>
</Project>
