/world/New()
    world.OpenPort(0)
    var/icon/source = icon('directions.dmi')
    var/icon/result = icon()
    for(var/D in list(SOUTH,NORTH,EAST,WEST))
        var/icon/selected = icon(source, dir=D)
        result.Insert(selected, "", dir=D)
        world.log << "D=[D] selected=[selected.GetPixel(1,1,"",SOUTH)] inserted=[result.GetPixel(1,1,"",D)]"
    fcopy(result, "result.dmi")
    shutdown()
